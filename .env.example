# --- Cursor SDK ---
# User API key from https://cursor.com/dashboard/api
# Must belong to an account with GitHub access to this repo (for cloud agents).
CURSOR_API_KEY=

# Optional: pin an exact model id instead of auto-discovering the newest
# Opus >= 4.8 model via Cursor.models.list(). Leave unset unless you need to
# force a specific id (e.g. while a new Opus version is rolling out).
RESEARCH_MODEL_ID=

# --- Repo the cloud agent clones ---
RESEARCH_REPO_URL=https://github.com/sanjeedanusrat/sanjeedanusrat
RESEARCH_REPO_REF=main

# --- Gmail (OAuth2 "installed app" credentials) ---
# Create an OAuth Client (type: Desktop app) in Google Cloud Console,
# then run `npm run gmail:setup` to mint a refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Email routing ---
RESEARCH_EMAIL_TO=sanjeedanusrat@gmail.com
RESEARCH_EMAIL_FROM=sanjeedanusrat@gmail.com

# Gmail search query used to pull newsletter context for the research agent.
# Defaults to a broad "recent newsletter-ish mail" query if unset.
GMAIL_NEWSLETTER_QUERY=newer_than:7d (category:promotions OR category:updates OR label:newsletters)
